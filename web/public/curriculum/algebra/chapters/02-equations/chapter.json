{
  "id": "algebra-equations",
  "title": "Equations",
  "description": "Solve linear equations and inequalities using inverse operations.",
  "lessons": [
    {
      "id": "one-step-equations",
      "title": "One-Step Equations",
      "objectives": ["Solve one-step equations using inverse operations"],
      "pedagogy": [
        {
          "type": "strategy",
          "title": "Undo the operation",
          "content": "Use the inverse operation to isolate the variable. Addition undoes subtraction; multiplication undoes division."
        }
      ],
      "content": [
        {
          "type": "paragraph",
          "content": "A one-step equation can be solved in a single step by applying the inverse operation to both sides."
        },
        {
          "type": "math",
          "latex": "x + 7 = 12 \\quad \\Rightarrow \\quad x = 12 - 7 = 5"
        }
      ],
      "exercises": [
        {
          "id": "solve-addition-equation",
          "type": "numeric",
          "question": "Solve $x + 8 = 15$.",
          "hints": ["Subtract 8 from both sides."],
          "answer": 7,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": "$x = 15 - 8 = 7$."
        },
        {
          "id": "solve-division-equation",
          "type": "numeric",
          "question": "Solve $\\frac{x}{4} = 6$.",
          "hints": ["Multiply both sides by 4."],
          "answer": 24,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": "$x = 6 \\times 4 = 24$."
        }
      ]
    },
    {
      "id": "two-step-equations",
      "title": "Two-Step Equations",
      "objectives": ["Solve two-step equations"],
      "pedagogy": [
        {
          "type": "strategy",
          "title": "Reverse PEMDAS",
          "content": "Undo addition and subtraction first, then multiplication and division."
        }
      ],
      "content": [
        {
          "type": "paragraph",
          "content": "Two-step equations require two inverse operations. First isolate the term with the variable, then isolate the variable itself."
        },
        {
          "type": "math",
          "latex": "2x + 5 = 13 \\quad \\Rightarrow \\quad 2x = 8 \\quad \\Rightarrow \\quad x = 4"
        }
      ],
      "exercises": [
        {
          "id": "solve-two-step",
          "type": "numeric",
          "question": "Solve $3x - 4 = 11$.",
          "hints": ["Add 4 to both sides.", "Divide both sides by 3."],
          "answer": 5,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": "$3x = 15$, so $x = 5$."
        }
      ]
    },
    {
      "id": "equations-with-variables-both-sides",
      "title": "Variables on Both Sides",
      "objectives": ["Solve equations with variables on both sides"],
      "pedagogy": [
        {
          "type": "pitfall",
          "title": "Watch your signs",
          "content": "When moving a term to the other side, its sign changes."
        }
      ],
      "content": [
        {
          "type": "paragraph",
          "content": "Collect variable terms on one side and constant terms on the other, then solve."
        },
        {
          "type": "math",
          "latex": "5x + 2 = 3x + 10 \\quad \\Rightarrow \\quad 2x = 8 \\quad \\Rightarrow \\quad x = 4"
        }
      ],
      "exercises": [
        {
          "id": "variables-both-sides",
          "type": "numeric",
          "question": "Solve $4x + 3 = 2x + 9$.",
          "hints": ["Subtract $2x$ from both sides.", "Subtract 3 from both sides.", "Divide by 2."],
          "answer": 3,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": "$2x = 6$, so $x = 3$."
        }
      ]
    }
  ]
}

