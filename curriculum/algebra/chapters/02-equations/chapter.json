{
  "id": "algebra-equations",
  "title": {
    "en": "Equations",
    "ro": "Ecuații"
  },
  "description": {
    "en": "Solve linear equations and inequalities using inverse operations.",
    "ro": "Rezolvă ecuații și inecuații liniare folosind operații inverse."
  },
  "lessons": [
    {
      "id": "one-step-equations",
      "title": "One-Step Equations",
      "objectives": ["Solve one-step equations using inverse operations"],
      "pedagogy": [
        {
          "type": "strategy",
          "title": {
            "en": "Undo the operation",
            "ro": "Anulează operația"
          },
          "content": {
            "en": "Use the inverse operation to isolate the variable. Addition undoes subtraction; multiplication undoes division.",
            "ro": "Folosește operația inversă pentru a izola variabila. Adunarea anulează scăderea; înmulțirea anulează împărțirea."
          }
        }
      ],
      "content": [
        {
          "type": "paragraph",
          "content": {
            "en": "A one-step equation can be solved in a single step by applying the inverse operation to both sides.",
            "ro": "O ecuație cu o operație poate fi rezolvată într-un singur pas aplicând operația inversă în ambii membri."
          }
        },
        {
          "type": "math",
          "latex": "x + 7 = 12 \\quad \\Rightarrow \\quad x = 12 - 7 = 5"
        }
      ],
      "exercises": [
        {
          "id": "solve-addition-equation",
          "type": "numeric",
          "question": {
            "en": "Solve $x + 8 = 15$.",
            "ro": "Rezolvă $x + 8 = 15$."
          },
          "hints": [
            {
              "en": "Subtract 8 from both sides.",
              "ro": "Scade 8 din ambii membri."
            }
          ],
          "answer": 7,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": "$x = 15 - 8 = 7$."
        },
        {
          "id": "solve-division-equation",
          "type": "numeric",
          "question": {
            "en": "Solve $\\frac{x}{4} = 6$.",
            "ro": "Rezolvă $\\frac{x}{4} = 6$."
          },
          "hints": [
            {
              "en": "Multiply both sides by 4.",
              "ro": "Înmulțește ambii membri cu 4."
            }
          ],
          "answer": 24,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": "$x = 6 \\times 4 = 24$."
        }
      ]
    },
    {
      "id": "two-step-equations",
      "title": "Two-Step Equations",
      "objectives": ["Solve two-step equations"],
      "pedagogy": [
        {
          "type": "strategy",
          "title": {
            "en": "Reverse PEMDAS",
            "ro": "Inversul ordinii operațiilor"
          },
          "content": {
            "en": "Undo addition and subtraction first, then multiplication and division.",
            "ro": "Anulează mai întâi adunarea și scăderea, apoi înmulțirea și împărțirea."
          }
        }
      ],
      "content": [
        {
          "type": "paragraph",
          "content": {
            "en": "Two-step equations require two inverse operations. First isolate the term with the variable, then isolate the variable itself.",
            "ro": "Ecuațiile cu două operații necesită două operații inverse. Mai întâi izolează termenul cu variabila, apoi izolează variabila însăși."
          }
        },
        {
          "type": "math",
          "latex": "2x + 5 = 13 \\quad \\Rightarrow \\quad 2x = 8 \\quad \\Rightarrow \\quad x = 4"
        }
      ],
      "exercises": [
        {
          "id": "solve-two-step",
          "type": "numeric",
          "question": {
            "en": "Solve $3x - 4 = 11$.",
            "ro": "Rezolvă $3x - 4 = 11$."
          },
          "hints": [
            {
              "en": "Add 4 to both sides.",
              "ro": "Adună 4 în ambii membri."
            },
            {
              "en": "Divide both sides by 3.",
              "ro": "Împarte ambii membri la 3."
            }
          ],
          "answer": 5,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": "$3x = 15$, so $x = 5$."
        }
      ]
    },
    {
      "id": "equations-with-variables-both-sides",
      "title": {
        "en": "Variables on Both Sides",
        "ro": "Variabile în Ambii Membri"
      },
      "objectives": [
        {
          "en": "Solve equations with variables on both sides",
          "ro": "Rezolvă ecuații cu variabile în ambii membri"
        }
      ],
      "pedagogy": [
        {
          "type": "pitfall",
          "title": {
            "en": "Watch your signs",
            "ro": "Atenție la semne"
          },
          "content": {
            "en": "When moving a term to the other side, its sign changes.",
            "ro": "Când muți un termen în celălalt membru, semnul lui se schimbă."
          }
        }
      ],
      "content": [
        {
          "type": "paragraph",
          "content": {
            "en": "Collect variable terms on one side and constant terms on the other, then solve.",
            "ro": "Adună termenii cu variabila într-un membru și termenii constanți în celălalt, apoi rezolvă."
          }
        },
        {
          "type": "math",
          "latex": "5x + 2 = 3x + 10 \\quad \\Rightarrow \\quad 2x = 8 \\quad \\Rightarrow \\quad x = 4"
        }
      ],
      "exercises": [
        {
          "id": "variables-both-sides",
          "type": "numeric",
          "question": {
            "en": "Solve $4x + 3 = 2x + 9$.",
            "ro": "Rezolvă $4x + 3 = 2x + 9$."
          },
          "hints": [
            {
              "en": "Subtract $2x$ from both sides.",
              "ro": "Scade $2x$ din ambii membri."
            },
            "Subtract 3 from both sides.",
            {
              "en": "Divide by 2.",
              "ro": "Împarte la 2."
            }
          ],
          "answer": 3,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": "$2x = 6$, so $x = 3$."
        }
      ]
    }
  ]
}
