{
  "id": "arithmetic-multiplication-division",
  "title": {
    "en": "Multiplication and Division",
    "ro": "Înmulțire și Împărțire"
  },
  "description": {
    "en": "Multiply and divide whole numbers and understand the relationship between the operations.",
    "ro": "Înmulțește și împarte numere întregi și înțelege relația dintre operații."
  },
  "lessons": [
    {
      "id": "multiplication-basics",
      "title": {
        "en": "Multiplication Basics",
        "ro": "Bazele Înmulțirii"
      },
      "objectives": [
        {
          "en": "Multiply multi-digit whole numbers",
          "ro": "Înmulțește numere întregi cu mai multe cifre"
        },
        {
          "en": "Understand multiplication as repeated addition",
          "ro": "Înțelege înmulțirea ca adunare repetată"
        }
      ],
      "pedagogy": [
        {
          "type": "mnemonic",
          "title": {
            "en": "Times tables",
            "ro": "Tabla înmulțirii"
          },
          "content": {
            "en": "5, 6, 7, 8: 56 is 7 times 8.",
            "ro": "5, 6, 7, 8: 56 este 7 ori 8."
          }
        }
      ],
      "content": [
        {
          "type": "paragraph",
          "content": {
            "en": "Multiplication is repeated addition. $4 \\times 3$ means 4 groups of 3, or $3 + 3 + 3 + 3 = 12$.",
            "ro": "Înmulțirea este adunare repetată. $4 \\times 3$ înseamnă 4 grupuri de câte 3, sau $3 + 3 + 3 + 3 = 12$."
          }
        },
        {
          "type": "math",
          "latex": "4 \\times 3 = 12"
        }
      ],
      "exercises": [
        {
          "id": "multiply-single",
          "type": "numeric",
          "question": {
            "en": "What is $7 \\times 8$?",
            "ro": "Cât este $7 \\times 8$?"
          },
          "hints": [
            {
              "en": "Remember: 56 is 7 times 8.",
              "ro": "Amintește-ți: 56 este 7 ori 8."
            }
          ],
          "answer": 56,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": {
            "en": "$7 \\times 8 = 56$.",
            "ro": "$7 \\times 8 = 56$."
          }
        },
        {
          "id": "multiply-two-digit",
          "type": "numeric",
          "question": {
            "en": "What is $14 \\times 6$?",
            "ro": "Cât este $14 \\times 6$?"
          },
          "hints": [
            {
              "en": "Break it into $10 \\times 6$ and $4 \\times 6$.",
              "ro": "Descompune în $10 \\times 6$ și $4 \\times 6$."
            }
          ],
          "answer": 84,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": {
            "en": "$14 \\times 6 = (10 \\times 6) + (4 \\times 6) = 60 + 24 = 84$.",
            "ro": "$14 \\times 6 = (10 \\times 6) + (4 \\times 6) = 60 + 24 = 84$."
          }
        }
      ]
    },
    {
      "id": "division-basics",
      "title": {
        "en": "Division Basics",
        "ro": "Bazele Împărțirii"
      },
      "objectives": [
        {
          "en": "Divide whole numbers with and without remainders",
          "ro": "Împarte numere întregi cu și fără rest"
        },
        {
          "en": "Relate division to multiplication",
          "ro": "Relaționează împărțirea cu înmulțirea"
        }
      ],
      "pedagogy": [
        {
          "type": "tip",
          "title": {
            "en": "Think backwards",
            "ro": "Gândește-te invers"
          },
          "content": {
            "en": "Division asks: how many groups of a size fit into a total? Use multiplication facts to check your answer.",
            "ro": "Împărțirea întreabă: câte grupuri de o anumită mărime încap într-un total? Folosește tabla înmulțirii pentru a verifica răspunsul."
          }
        }
      ],
      "content": [
        {
          "type": "paragraph",
          "content": {
            "en": "Division splits a total into equal groups. $20 \\div 5 = 4$ because 4 groups of 5 make 20.",
            "ro": "Împărțirea împarte un total în grupuri egale. $20 \\div 5 = 4$ pentru că 4 grupuri de câte 5 fac 20."
          }
        },
        {
          "type": "math",
          "latex": "20 \\div 5 = 4 \\quad \\text{because} \\quad 4 \\times 5 = 20"
        }
      ],
      "exercises": [
        {
          "id": "divide-no-remainder",
          "type": "numeric",
          "question": {
            "en": "What is $48 \\div 6$?",
            "ro": "Cât este $48 \\div 6$?"
          },
          "hints": [
            {
              "en": "Ask: what times 6 equals 48?",
              "ro": "Întreabă-te: cât ori 6 egal 48?"
            }
          ],
          "answer": 8,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": {
            "en": "$48 \\div 6 = 8$ because $8 \\times 6 = 48$.",
            "ro": "$48 \\div 6 = 8$ pentru că $8 \\times 6 = 48$."
          }
        },
        {
          "id": "divide-remainder",
          "type": "free-response",
          "question": {
            "en": "What is $23 \\div 4$? Write your answer as a quotient and remainder (for example, 5 R 3).",
            "ro": "Cât este $23 \\div 4$? Scrie răspunsul ca cât și rest (de exemplu, 5 R 3)."
          },
          "hints": [
            {
              "en": "Find the largest multiple of 4 that is less than or equal to 23.",
              "ro": "Găsește cel mai mare multiplu de 4 care este mai mic sau egal cu 23."
            },
            {
              "en": "$4 \\times 5 = 20$, so the remainder is 3.",
              "ro": "$4 \\times 5 = 20$, deci restul este 3."
            }
          ],
          "answer": "5 R 3",
          "validation": "exact",
          "maxAttempts": 3,
          "solution": {
            "en": "$23 \\div 4 = 5$ remainder $3$ because $4 \\times 5 = 20$ and $23 - 20 = 3$.",
            "ro": "$23 \\div 4 = 5$ rest $3$ pentru că $4 \\times 5 = 20$ și $23 - 20 = 3$."
          }
        }
      ]
    },
    {
      "id": "area-model-multiplication",
      "title": {
        "en": "Area Model for Multiplication",
        "ro": "Modelul Ariei pentru Înmulțire"
      },
      "objectives": [
        {
          "en": "Multiply using the area model",
          "ro": "Înmulțește folosind modelul ariei"
        }
      ],
      "pedagogy": [
        {
          "type": "strategy",
          "title": {
            "en": "Break it into rectangles",
            "ro": "Descompune în dreptunghiuri"
          },
          "content": {
            "en": "Split each factor into tens and ones, then find the area of each smaller rectangle and add them.",
            "ro": "Descompune fiecare factor în zeci și unități, apoi găsește aria fiecărui dreptunghi mai mic și adună-le."
          }
        }
      ],
      "content": [
        {
          "type": "paragraph",
          "content": {
            "en": "The area model represents multiplication as the area of a rectangle. For $13 \\times 12$, split 13 into 10 and 3, and 12 into 10 and 2.",
            "ro": "Modelul ariei reprezintă înmulțirea ca aria unui dreptunghi. Pentru $13 \\times 12$, descompune 13 în 10 și 3, iar 12 în 10 și 2."
          }
        },
        {
          "type": "math",
          "latex": "13 \\times 12 = (10 + 3)(10 + 2) = 100 + 20 + 30 + 6 = 156"
        }
      ],
      "exercises": [
        {
          "id": "area-model-draw",
          "type": "drawing",
          "question": {
            "en": "Draw an area model for $14 \\times 11$ and label the four partial products.",
            "ro": "Desenează un model al ariei pentru $14 \\times 11$ și etichetează cele patru produse parțiale."
          },
          "hints": [
            {
              "en": "Split 14 into 10 and 4.",
              "ro": "Descompune 14 în 10 și 4."
            },
            {
              "en": "Split 11 into 10 and 1.",
              "ro": "Descompune 11 în 10 și 1."
            },
            {
              "en": "The four areas are 100, 10, 40, and 4.",
              "ro": "Cele patru arii sunt 100, 10, 40 și 4."
            }
          ],
          "drawingMode": "freehand",
          "validation": "manual",
          "maxAttempts": 1,
          "solution": {
            "en": "A rectangle split into 10x10=100, 10x1=10, 4x10=40, and 4x1=4. Total 154.",
            "ro": "Un dreptunghi împărțit în 10x10=100, 10x1=10, 4x10=40 și 4x1=4. Total 154."
          }
        }
      ]
    }
  ]
}
