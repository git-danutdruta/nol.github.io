{
  "id": "arithmetic-addition-subtraction",
  "title": {
    "en": "Addition and Subtraction",
    "ro": "Adunare și Scădere"
  },
  "description": {
    "en": "Add and subtract whole numbers, fractions, and decimals with confidence.",
    "ro": "Adună și scade numere întregi, fracții și zecimale cu încredere."
  },
  "lessons": [
    {
      "id": "addition-basics",
      "title": {
        "en": "Addition Basics",
        "ro": "Bazele Adunării"
      },
      "objectives": [
        {
          "en": "Add multi-digit whole numbers",
          "ro": "Adună numere întregi cu mai multe cifre"
        },
        {
          "en": "Use carrying correctly",
          "ro": "Folosește corect transferul"
        }
      ],
      "pedagogy": [
        {
          "type": "trick",
          "title": {
            "en": "Carry the one",
            "ro": "Transferă unul"
          },
          "content": {
            "en": "When a column sums to 10 or more, write the ones digit and carry the tens digit to the next column.",
            "ro": "Când suma unei coloane este 10 sau mai mare, scrie cifra unităților și transferă cifra zecilor în coloana următoare."
          }
        }
      ],
      "content": [
        {
          "type": "paragraph",
          "content": {
            "en": "Addition combines quantities. Align numbers by place value and add each column from right to left.",
            "ro": "Adunarea combină cantități. Aliniază numerele după valoarea pozițională și adună fiecare coloană de la dreapta la stânga."
          }
        },
        {
          "type": "math",
          "latex": "\\begin{array}{r} 247 \\\\ + 385 \\\\ \\hline 632 \\end{array}"
        }
      ],
      "exercises": [
        {
          "id": "add-two-digit",
          "type": "numeric",
          "question": {
            "en": "What is $47 + 58$?",
            "ro": "Cât este $47 + 58$?"
          },
          "hints": [
            {
              "en": "Add the ones: 7 + 8 = 15. Carry the 1.",
              "ro": "Adună unitățile: 7 + 8 = 15. Transferă 1."
            },
            {
              "en": "Add the tens: 4 + 5 + 1 = 10.",
              "ro": "Adună zecile: 4 + 5 + 1 = 10."
            }
          ],
          "answer": 105,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": {
            "en": "$47 + 58 = 105$.",
            "ro": "$47 + 58 = 105$."
          }
        },
        {
          "id": "add-three-digit",
          "type": "numeric",
          "question": {
            "en": "What is $256 + 478$?",
            "ro": "Cât este $256 + 478$?"
          },
          "hints": [
            {
              "en": "Carry from the ones column.",
              "ro": "Transferă din coloana unităților."
            },
            {
              "en": "Carry from the tens column.",
              "ro": "Transferă din coloana zecilor."
            }
          ],
          "answer": 734,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": {
            "en": "$256 + 478 = 734$.",
            "ro": "$256 + 478 = 734$."
          }
        }
      ]
    },
    {
      "id": "subtraction-basics",
      "title": {
        "en": "Subtraction Basics",
        "ro": "Bazele Scăderii"
      },
      "objectives": [
        {
          "en": "Subtract multi-digit whole numbers",
          "ro": "Scade numere întregi cu mai multe cifre"
        },
        {
          "en": "Use borrowing correctly",
          "ro": "Folosește corect împrumutul"
        }
      ],
      "pedagogy": [
        {
          "type": "strategy",
          "title": {
            "en": "Borrow when needed",
            "ro": "Împrumută când este nevoie"
          },
          "content": {
            "en": "If the top digit in a column is smaller than the bottom digit, borrow 1 from the next column to the left.",
            "ro": "Dacă cifra de sus dintr-o coloană este mai mică decât cea de jos, împrumută 1 din coloana următoare din stânga."
          }
        }
      ],
      "content": [
        {
          "type": "paragraph",
          "content": {
            "en": "Subtraction finds the difference between two numbers. Borrow when the digit on top is too small.",
            "ro": "Scăderea află diferența dintre două numere. Împrumută când cifra de sus este prea mică."
          }
        },
        {
          "type": "math",
          "latex": "\\begin{array}{r} 503 \\\\ - 267 \\\\ \\hline 236 \\end{array}"
        }
      ],
      "exercises": [
        {
          "id": "subtract-borrow",
          "type": "numeric",
          "question": {
            "en": "What is $503 - 267$?",
            "ro": "Cât este $503 - 267$?"
          },
          "hints": [
            {
              "en": "You need to borrow from the hundreds.",
              "ro": "Trebuie să împrumuți de la sute."
            },
            {
              "en": "503 becomes 4 hundreds, 9 tens, and 13 ones.",
              "ro": "503 devine 4 sute, 9 zeci și 13 unități."
            }
          ],
          "answer": 236,
          "validation": "numeric",
          "maxAttempts": 3,
          "solution": {
            "en": "$503 - 267 = 236$.",
            "ro": "$503 - 267 = 236$."
          }
        }
      ]
    },
    {
      "id": "add-subtract-fractions",
      "title": {
        "en": "Adding and Subtracting Fractions",
        "ro": "Adunarea și Scăderea Fracțiilor"
      },
      "objectives": [
        {
          "en": "Add and subtract fractions with like denominators",
          "ro": "Adună și scade fracții cu numitori egali"
        }
      ],
      "pedagogy": [
        {
          "type": "pitfall",
          "title": {
            "en": "Do not add denominators",
            "ro": "Nu aduna numitorii"
          },
          "content": {
            "en": "When adding fractions with the same denominator, only add the numerators. The denominator stays the same.",
            "ro": "Când aduni fracții cu același numitor, adună doar numărătorii. Numitorul rămâne neschimbat."
          }
        }
      ],
      "content": [
        {
          "type": "paragraph",
          "content": {
            "en": "Fractions with the same denominator can be added or subtracted by combining the numerators.",
            "ro": "Fracțiile cu același numitor pot fi adunate sau scăzute prin combinarea numărătorilor."
          }
        },
        {
          "type": "math",
          "latex": "\\frac{2}{7} + \\frac{3}{7} = \\frac{5}{7}"
        }
      ],
      "exercises": [
        {
          "id": "add-fractions-like",
          "type": "expression",
          "question": {
            "en": "Simplify $\\frac{3}{8} + \\frac{2}{8}$.",
            "ro": "Simplifică $\\frac{3}{8} + \\frac{2}{8}$."
          },
          "hints": [
            {
              "en": "Add the numerators.",
              "ro": "Adună numărătorii."
            },
            {
              "en": "Keep the denominator 8.",
              "ro": "Păstrează numitorul 8."
            }
          ],
          "answer": "5/8",
          "validation": "expression",
          "maxAttempts": 3,
          "solution": "$\\frac{3}{8} + \\frac{2}{8} = \\frac{5}{8}$."
        },
        {
          "id": "subtract-fractions-like",
          "type": "expression",
          "question": {
            "en": "Simplify $\\frac{5}{6} - \\frac{1}{6}$.",
            "ro": "Simplifică $\\frac{5}{6} - \\frac{1}{6}$."
          },
          "hints": [
            {
              "en": "Subtract the numerators.",
              "ro": "Scade numărătorii."
            },
            {
              "en": "Keep the denominator 6.",
              "ro": "Păstrează numitorul 6."
            }
          ],
          "answer": "4/6",
          "validation": "expression",
          "maxAttempts": 3,
          "solution": {
            "en": "$\\frac{5}{6} - \\frac{1}{6} = \\frac{4}{6} = \\frac{2}{3}$.",
            "ro": "$\\frac{5}{6} - \\frac{1}{6} = \\frac{4}{6} = \\frac{2}{3}$."
          }
        }
      ]
    }
  ]
}
